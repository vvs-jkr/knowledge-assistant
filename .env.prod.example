# Database
DATABASE_URL=sqlite:./data/knowledge.db

# Security — generate with: openssl rand -hex 32
JWT_SECRET=
ENCRYPTION_KEY=

# AI
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# App
PORT=8080
FRONTEND_URL=http://YOUR_SERVER_IP
RUST_LOG=knowledge_api=info,tower_http=info

# The web container uses same-origin /api and proxies it to the API service.
# No host-specific frontend build variables are required.
